#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

# Remove cache for safety
rm -rf output .spago .cache ../phpurs-*/output ../phpurs-*/.spago ../phpurs-*/.cache

rm -f spago.yaml
ln -s spago.php.yaml spago.yaml

echo "=== Building project with spago ==="
spago build || { echo "Spago build failed"; exit 1; }

echo "=== Generating PHP code with phpurs ==="
node ../phpurs/bin/phpurs.js --main Test.Main || exit 1

echo "=== Running PHP test script ==="
if [ -d "output/Test.Main" ]; then
    cat << 'EOF' > scratch_test.php
<?php
require_once "output/Test.Main/main.mod.php";
EOF
    php scratch_test.php
else
    echo "No output/Test.Main/main found."
    exit 1
fi
echo -e "\n✅ Tests passed successfully!"
